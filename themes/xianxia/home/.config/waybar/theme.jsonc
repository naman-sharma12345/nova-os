{
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 5
    },
    "format-icons": {
      "active": "◆",
      "default": "◇",
      "empty": "·"
    }
  },
  "custom/crest": {
    "format": "{}",
    "exec": "echo '<span font=\"Cinzel Decorative 15\" letter_spacing=\"2048\">TIANXIA</span>'",
    "interval": "once",
    "tooltip": true,
    "tooltip-format": "The path to immortality",
    "on-click": "tenka-launcher",
    "on-click-right": "tenka-theme-menu"
  }
}
