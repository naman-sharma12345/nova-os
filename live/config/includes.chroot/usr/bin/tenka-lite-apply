#!/bin/bash
# Applies the current theme pack to the XFCE (Tenka Lite) session.
#   tenka-lite-apply           live re-theme (theme switch inside a running session)
#   tenka-lite-apply --seed    before startxfce4: writes the settings straight into xfconf's XML,
#                              so XFCE's very first frame is already themed (no black first login)
#   tenka-lite-apply --login   session autostart: only the per-login bits when --seed already ran
T=$(tenka-theme --current); D=/usr/share/tenka/themes/$T; . "$D/theme.env"
mkdir -p "$HOME/.cache/tenka"
STAMP="$HOME/.cache/tenka/lite-seeded"
XD="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml"
x() { xfconf-query -c "$1" -p "$2" --create -t "$3" -s "$4" 2>/dev/null; }
W=$(ls "$D"/wallpapers/1080/00-desktop.jpg 2>/dev/null | head -1); [ -z "$W" ] && W=$(ls "$D"/wallpapers/1080/13-*.jpg 2>/dev/null | head -1); [ -z "$W" ] && W=$(ls "$D"/wallpapers/1080/0*.jpg 2>/dev/null | head -1); [ -z "$W" ] && W=$(ls "$D"/wallpapers/0*.jpg | head -1)
MONS=$(xrandr --listmonitors 2>/dev/null | awk 'NR>1 {print $NF}')
PAL=$(sed -n 's/^ColorPalette=//p' "$D/home/.config/xfce4/terminal/terminalrc" 2>/dev/null)

# files every mode needs (cheap: no xfconf round trips)
ln -sf "$W" "$HOME/.cache/tenka/wallpaper"
cp -f "$D/lite-session.css" "$HOME/.cache/tenka/session.css" 2>/dev/null   # xfwm4 has no blur: denser glass (gtk.css imports it)
ln -sfn "$D/lock" "$HOME/.cache/tenka/lock"                               # lock art follows the theme
# the dock's open-app mark: a short accent rule on the focused app, a dim gold one on the others
DR="$HOME/.config/xfce4/panel/docklike-3.rc"
if [ -f "$DR" ]; then
  rgb() { printf 'rgb(%d,%d,%d)' 0x${1:1:2} 0x${1:3:2} 0x${1:5:2}; }
  rgba() { printf 'rgba(%d,%d,%d,%s)' 0x${1:1:2} 0x${1:3:2} 0x${1:5:2} "$2"; }
  sed -i -E '/^(indicator|inactive)/d' "$DR"
  printf 'indicatorOrientation=0\nindicatorStyle=5\ninactiveIndicatorStyle=5\nindicatorColorFromTheme=false\nindicatorColor=%s\ninactiveColor=%s\n' \
    "$(rgb "$C_ACCENT")" "$(rgba "$C_ACCENT2" 0.55)" >> "$DR"
fi

seed() {   # xfconfd is not running yet: write its XML, XFCE reads it on start
  mkdir -p "$XD"
  p() { printf '    <property name="%s" type="%s" value="%s"/>\n' "$1" "$2" "$3"; }
  { echo '<?xml version="1.0" encoding="UTF-8"?>'; echo '<channel name="xsettings" version="1.0">'
    echo '  <property name="Net" type="empty">'; p ThemeName string "$THEME_GTK"; p IconThemeName string "$THEME_ICONS"; echo '  </property>'
    echo '  <property name="Gtk" type="empty">'; p CursorThemeName string "$THEME_CURSOR"; p CursorThemeSize int 24
    p FontName string "Inter 10"; p MonospaceFontName string "JetBrains Mono 10"; echo '  </property>'
    echo '  <property name="Xft" type="empty">'; p Antialias int 1; p HintStyle string hintslight; p RGBA string rgb; echo '  </property>'
    echo '</channel>'; } > "$XD/xsettings.xml"
  { echo '<?xml version="1.0" encoding="UTF-8"?>'; echo '<channel name="xfce4-notifyd" version="1.0">'
    echo "  <property name=\"theme\" type=\"string\" value=\"$THEME_GTK\"/>"
    echo '  <property name="notify-location" type="string" value="top-right"/>'; echo '</channel>'; } > "$XD/xfce4-notifyd.xml"
  { echo '<?xml version="1.0" encoding="UTF-8"?>'; echo '<channel name="xfce4-terminal" version="1.0">'
    for kv in "background-mode string TERMINAL_BACKGROUND_SOLID" "color-background string $C_BASE" "color-foreground string $C_TEXT" \
              "color-bold string $C_TEXT" "color-cursor string $C_ACCENT" "color-selection string $C_OVERLAY"; do
      set -- $kv; echo "  <property name=\"$1\" type=\"$2\" value=\"$3\"/>"; done
    [ -n "$PAL" ] && echo "  <property name=\"color-palette\" type=\"string\" value=\"$PAL\"/>"
    echo '</channel>'; } > "$XD/xfce4-terminal.xml"
  { echo '<?xml version="1.0" encoding="UTF-8"?>'; echo '<channel name="xfce4-desktop" version="1.0">'
    echo '  <property name="desktop-icons" type="empty"><property name="style" type="int" value="0"/></property>'
    echo '  <property name="desktop-menu" type="empty"><property name="show" type="bool" value="true"/><property name="show-icons" type="bool" value="false"/></property>'
    echo '  <property name="backdrop" type="empty"><property name="screen0" type="empty">'
    for m in $MONS; do echo "    <property name=\"monitor$m\" type=\"empty\">"
      for ws in 0 1 2 3; do echo "      <property name=\"workspace$ws\" type=\"empty\"><property name=\"last-image\" type=\"string\" value=\"$W\"/><property name=\"image-style\" type=\"int\" value=\"5\"/></property>"; done
      echo '    </property>'; done
    echo '  </property></property>'; echo '</channel>'; } > "$XD/xfce4-desktop.xml"
  [ -f "$XD/xfwm4.xml" ] && sed -i -E \
    -e "s|(name=\"theme\" type=\"string\" value=)\"[^\"]*\"|\1\"$THEME_GTK\"|" \
    -e "s|(name=\"title_font\" type=\"string\" value=)\"[^\"]*\"|\1\"Marcellus 11\"|" "$XD/xfwm4.xml"
  [ -f "$XD/xfce4-screensaver.xml" ] && sed -i -E \
    "s|(name=\"location\" type=\"string\" value=)\"[^\"]*\"|\1\"$HOME/.cache/tenka/lock\"|" "$XD/xfce4-screensaver.xml"
  if [ -f "$XD/xfce4-panel.xml" ]; then   # whisker's label + crest (plugin-1 is the only one with these keys)
    sed -i -E '/name="(button-title|button-icon)"/d' "$XD/xfce4-panel.xml"
    sed -i -E "s|^( *)(<property name=\"show-button-title\" type=\"bool\" value=\")[a-z]*(\"/>)|\1\2false\3\n\1<property name=\"button-title\" type=\"string\" value=\"$THEME_DISPLAY\"/>\n\1<property name=\"button-icon\" type=\"string\" value=\"$D/crest-1024.png\"/>|" "$XD/xfce4-panel.xml"
  fi
  # seeded only when the monitors were known (else --login sets the wallpaper through xfconf)
  [ -n "$MONS" ] && echo "$T" > "$STAMP"
}

live() {   # a running session: through xfconfd
  x xsettings /Net/ThemeName string "$THEME_GTK"
  x xsettings /Net/IconThemeName string "$THEME_ICONS"
  x xsettings /Gtk/CursorThemeName string "$THEME_CURSOR"
  x xsettings /Gtk/CursorThemeSize int 24
  x xsettings /Gtk/FontName string "Inter 10"
  x xsettings /Gtk/MonospaceFontName string "JetBrains Mono 10"
  x xsettings /Xft/Antialias int 1
  x xsettings /Xft/HintStyle string hintslight
  x xsettings /Xft/RGBA string rgb
  x xfwm4 /general/theme string "$THEME_GTK"
  x xfwm4 /general/title_font string "Marcellus 11"
  x xfce4-notifyd /theme string "$THEME_GTK"
  x xfce4-notifyd /notify-location string top-right
  # wallpaper on every monitor/workspace (1080p copies are lighter for Lite)
  for p in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'last-image$'); do x xfce4-desktop "$p" string "$W"; done
  for m in $MONS; do
    for ws in 0 1 2 3; do
      x xfce4-desktop "/backdrop/screen0/monitor$m/workspace$ws/last-image" string "$W"
      x xfce4-desktop "/backdrop/screen0/monitor$m/workspace$ws/image-style" int 5
    done
  done
  x xfce4-screensaver /screensavers/xfce-personal-slideshow/location string "$HOME/.cache/tenka/lock"
  # Lite's terminal (xfce4-terminal >= 1.1 keeps its settings in xfconf): solid ink, no blur under xfwm4
  x xfce4-terminal /background-mode string TERMINAL_BACKGROUND_SOLID
  x xfce4-terminal /color-background string "$C_BASE"
  x xfce4-terminal /color-foreground string "$C_TEXT"
  x xfce4-terminal /color-bold string "$C_TEXT"
  x xfce4-terminal /color-cursor string "$C_ACCENT"
  x xfce4-terminal /color-selection string "$C_OVERLAY"
  [ -n "$PAL" ] && x xfce4-terminal /color-palette string "$PAL"
  # whisker menu label + crest (Whisker 2.x keeps its settings in xfconf and follows them live)
  x xfce4-panel /plugins/plugin-1/button-title string "$THEME_DISPLAY"
  x xfce4-panel /plugins/plugin-1/show-button-title bool false
  x xfce4-panel /plugins/plugin-1/button-icon string "$D/crest-1024.png"
  echo "$T" > "$STAMP"
}

case "${1:-}" in
  --seed)
    xsetroot -solid "$C_BASE" 2>/dev/null   # ink, not black, for the second XFCE takes to paint
    if pgrep -u "$(id -u)" -x xfconfd >/dev/null; then live; else seed; fi
    exit 0 ;;
  --login)
    # --seed already wrote this theme's settings before XFCE started: nothing to push through xfconf
    [ "$(cat "$STAMP" 2>/dev/null)" = "$T" ] || live ;;
  *)
    live
    # quit + start, not `xfce4-panel -r`: a restarted panel loses its transparent (ARGB) window and the bare bar turns black
    if pgrep -u "$(id -u)" -x xfce4-panel >/dev/null; then
      xfce4-panel --quit >/dev/null 2>&1; sleep 1; (setsid xfce4-panel >/dev/null 2>&1 &)
    fi ;;
esac
# the desk title card (clock, seal, date, proverb), mirroring the Tenka shell
if command -v conky >/dev/null; then
  pkill -u "$(id -u)" -f 'conky -c /usr/share/tenka/conky/desk.conf' 2>/dev/null
  (setsid conky -c /usr/share/tenka/conky/desk.conf >/dev/null 2>&1 &)
fi
if [ "${1:-}" = --login ]; then
  tenka-sound login &
  [ -e "$HOME/.config/tenka/welcomed" ] || tenka-welcome &
fi
exit 0
