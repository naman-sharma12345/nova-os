# Tianxia colours for git (generated by scripts/gen-themes.py)
[color]
	ui = auto
[color "branch"]
	current = "#e2bd6b" bold
	local = "#a9bdb4"
	remote = "#6fd3c6"
	upstream = "#6fd3c6"
[color "diff"]
	meta = "#e2bd6b"
	frag = "#8fb3d1"
	func = "#a9bdb4"
	commit = "#e2bd6b"
	old = "#5fc9a0"
	new = "#5fc9a0"
	whitespace = "#5fc9a0" reverse
[color "status"]
	header = "#72827c"
	branch = "#e2bd6b" bold
	added = "#5fc9a0"
	updated = "#5fc9a0"
	changed = "#e2bd6b"
	untracked = "#a9bdb4"
	unmerged = "#5fc9a0" bold
[color "decorate"]
	HEAD = "#5fc9a0" bold
	branch = "#e2bd6b"
	remoteBranch = "#6fd3c6"
	tag = "#f0a3b8"
	stash = "#72827c"
[color "grep"]
	match = "#5fc9a0" bold
	filename = "#e2bd6b"
	linenumber = "#72827c"
	separator = "#51635e"
