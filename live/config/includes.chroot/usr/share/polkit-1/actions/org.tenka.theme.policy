<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Tenka</vendor>
  <action id="org.tenka.theme.system">
    <description>Apply the Tenka theme to the boot splash, boot menu and login screen</description>
    <message>Applying a theme to the boot and login screens</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/tenka/tenka-theme-system</annotate>
  </action>
</policyconfig>
