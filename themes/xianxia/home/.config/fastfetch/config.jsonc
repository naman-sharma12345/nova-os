{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/tenka/themes/xianxia/fastfetch/logo.txt",
    "color": {
      "1": "38;2;95;201;160",
      "2": "38;2;226;189;107",
      "3": "38;2;238;243;236"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;226;189;107",
      "title": "38;2;95;201;160"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;95;201;160mTIANXIA\u001b[0m  \u001b[38;2;169;189;180m— the path to immortality\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;29;51;46m────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "  Realm",
      "keyColor": "38;2;226;189;107",
      "format": "Tianxia {version-id} ({codename})"
    },
    {
      "type": "kernel",
      "key": "  Core",
      "keyColor": "38;2;226;189;107"
    },
    {
      "type": "wm",
      "key": "  Sect",
      "keyColor": "38;2;226;189;107"
    },
    {
      "type": "shell",
      "key": "  Scripture",
      "keyColor": "38;2;226;189;107"
    },
    {
      "type": "terminal",
      "key": "  Talisman",
      "keyColor": "38;2;226;189;107"
    },
    {
      "type": "theme",
      "key": "  Robes",
      "keyColor": "38;2;226;189;107",
      "format": "Tianxia · The path to immortality"
    },
    {
      "type": "packages",
