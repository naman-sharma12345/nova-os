<?xml version="1.0" encoding="UTF-8"?>
<!-- Tenka Lite panels, mirroring the Tenka shell: a bar that is almost nothing (workspace dots,
     tray, sound, the time), and an auto-hiding dock at the bottom with the crest apart on its left: one low ink bar
     (no blur under xfwm4, so it is denser than the flagship's glass) with a gold hairline on top. -->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <value type="int" value="2"/>
    <property name="dark-mode" type="bool" value="true"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="double" value="100"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="30"/>
      <property name="icon-size" type="uint" value="14"/>
      <property name="background-style" type="uint" value="0"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0"/><value type="double" value="0"/><value type="double" value="0"/><value type="double" value="0"/>
      </property>
      <property name="enter-opacity" type="uint" value="100"/>
      <property name="leave-opacity" type="uint" value="100"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="12"/>
        <value type="int" value="11"/>
        <value type="int" value="4"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="5"/>
        <value type="int" value="13"/>
      </property>
    </property>
    <property name="panel-2" type="empty">
      <property name="position" type="string" value="p=10;x=960;y=1040"/>
      <property name="length" type="double" value="1"/>
      <property name="length-adjust" type="bool" value="true"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="54"/>
      <property name="icon-size" type="uint" value="30"/>
      <property name="autohide-behavior" type="uint" value="1"/>
      <property name="background-style" type="uint" value="1"/>
      <property name="background-rgba" type="array">
        <value type="double" value="0.04"/><value type="double" value="0.035"/><value type="double" value="0.03"/><value type="double" value="0.86"/>
      </property>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="show-button-title" type="bool" value="false"/>
      <!-- categories as words only: the 16 px category icons mixed line glyphs with a full folder (Favorites) -->
      <property name="category-icon-size" type="int" value="-1"/>
      <property name="favorites" type="array">
        <value type="string" value="firefox-esr.desktop"/>
        <value type="string" value="thunar.desktop"/>
        <value type="string" value="xfce4-terminal.desktop"/>
        <value type="string" value="org.xfce.mousepad.desktop"/>
        <value type="string" value="mpv.desktop"/>
        <value type="string" value="tenka-theme.desktop"/>
      </property>
    </property>
    <property name="plugin-2" type="string" value="separator">
      <property name="style" type="uint" value="1"/>
    </property>
    <property name="plugin-3" type="string" value="docklike"/>
    <property name="plugin-12" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-11" type="string" value="genmon"/>
    <property name="plugin-4" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-7" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
      <property name="icon-size" type="int" value="14"/>
    </property>
    <property name="plugin-8" type="string" value="pulseaudio">
      <property name="enable-keyboard-shortcuts" type="bool" value="false"/>
      <property name="show-notifications" type="uint" value="0"/>
    </property>
    <property name="plugin-5" type="string" value="genmon"/>
    <property name="plugin-13" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>
  </property>
</channel>
