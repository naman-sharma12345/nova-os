#!/bin/sh
# Tenka: system setup inside the image.
set -e
mkdir -p /etc/default /etc/sysctl.d /etc/sddm.conf.d

# ---------------------------------------------------------------- thumbnails
# tenka-pixbuf.thumbnailer owns AVIF/WebP/SVG/HEIF (a helper process per file). Divert the stock files that call
# gdk-pixbuf-thumbnailer directly: the catch-all one would push JPEG/PNG through a subprocess too, and the per-format
# ones would run without the full loader list. tenka-video.thumbnailer replaces ffmpegthumbnailer's with a 30 s timeout.
for t in gdk-pixbuf-thumbnailer avif webp-pixbuf librsvg ffmpegthumbnailer; do
  f=/usr/share/thumbnailers/$t.thumbnailer
  if ! dpkg-divert --list "$f" | grep -q .; then dpkg-divert --quiet --local --rename --add --divert "$f.tenka-off" "$f"; fi
done

# ---------------------------------------------------------------- installer
# includes.chroot carries Tenka's calamares-bootloader-config (works without a package pool on the ISO); divert without
# --rename so a calamares-settings-debian upgrade writes its copy to .debian instead of over ours
f=/usr/share/calamares/helpers/calamares-bootloader-config
if ! dpkg-divert --list "$f" | grep -q .; then dpkg-divert --quiet --local --add --divert "$f.debian" "$f"; fi

# ---------------------------------------------------------------- identity
if [ ! -e /usr/lib/os-release.debian ]; then
  dpkg-divert --quiet --local --rename --add --divert /usr/lib/os-release.debian /usr/lib/os-release
fi
cat > /usr/lib/os-release <<'EOF'
PRETTY_NAME="Tenka 0.1 · The way of the blade"
NAME="Tenka"
VERSION_ID="0.1"
VERSION="0.1 (Dawn)"
VERSION_CODENAME=trixie
DEBIAN_VERSION_CODENAME=trixie
ID=tenka
ID_LIKE=debian
HOME_URL="https://github.com/naman-sharma12345/tenka"
SUPPORT_URL="https://github.com/naman-sharma12345/tenka/issues"
BUG_REPORT_URL="https://github.com/naman-sharma12345/tenka/issues"
LOGO=tenka
EOF
ln -sf ../usr/lib/os-release /etc/os-release
printf 'Tenka 0.1 \\n \\l\n\n' > /etc/issue
printf 'Tenka 0.1\n' > /etc/issue.net
mkdir -p /etc/tenka; [ -f /etc/tenka/theme ] || echo samurai > /etc/tenka/theme
install -Dm644 /usr/share/tenka/themes/samurai/crest-1024.png /usr/share/pixmaps/tenka.png 2>/dev/null || true
install -Dm644 /usr/share/tenka/themes/samurai/crest-1024.png /usr/share/icons/hicolor/512x512/apps/tenka.png 2>/dev/null || true
# the Tenka icon themes ship as files (includes.chroot): rebuild their caches so a stale cache never hides
# a newly drawn icon (GTK trusts icon-theme.cache over the directory listing)
for t in /usr/share/icons/Tenka-* /usr/share/icons/hicolor; do [ -d "$t" ] && gtk-update-icon-cache -f -q "$t" 2>/dev/null || true; done

# sudo's first-time lecture in the desk's words (etc/sudoers.d/tenka): sudo reads a drop-in only when root owns it
# and nobody else can write to it, and visudo wants 0440
chown root:root /etc/sudoers.d/tenka && chmod 0440 /etc/sudoers.d/tenka

# ---------------------------------------------------------------- services
systemctl enable sddm.service || true
systemctl set-default graphical.target || true
systemctl enable NetworkManager.service || true
systemctl enable tenka-session-default.service || true
systemctl enable tenka-timezone.service || true
systemctl --global enable tenka-hour.timer || true   # the desk's hour and season (tenka-hour)
systemctl --global enable tenka-watch.timer || true  # the watch: a bell at each double-hour, when kept (tenka-watch)
systemctl enable zramswap.service 2>/dev/null || true
for s in spice-vdagentd qemu-guest-agent open-vm-tools; do systemctl enable "$s" 2>/dev/null || true; done
# low-end: nothing heavy idling in the background
for s in apt-daily.timer apt-daily-upgrade.timer man-db.timer e2scrub_all.timer; do systemctl disable "$s" 2>/dev/null || true; done
printf 'ALGO=zstd\nPERCENT=50\nPRIORITY=100\n' > /etc/default/zramswap
printf 'vm.swappiness=100\nvm.vfs_cache_pressure=50\nvm.page-cluster=0\n' > /etc/sysctl.d/90-tenka-zram.conf
[ -f /etc/X11/Xwrapper.config ] && sed -i 's/^allowed_users=.*/allowed_users=anybody/' /etc/X11/Xwrapper.config || true

# ---------------------------------------------------------------- sessions
for f in /usr/share/wayland-sessions/hyprland.desktop /usr/share/wayland-sessions/hyprland-uwsm.desktop /usr/share/xsessions/xfce.desktop; do
  [ -f "$f" ] && { grep -q '^Hidden=' "$f" || printf 'NoDisplay=true\nHidden=true\n' >> "$f"; }
done
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-tenka.conf <<'EOF'
[General]
DisplayServer=x11
InputMethod=
Numlock=none

[Theme]
Current=tenka-samurai
CursorTheme=Tenka-Samurai-Cursors
CursorSize=24
Font=Marcellus

[Users]
RememberLastSession=true
RememberLastUser=true
EOF
mkdir -p /etc/environment.d
cat > /etc/environment.d/90-tenka.conf <<'EOF'
QT_QPA_PLATFORMTHEME=qt6ct
XCURSOR_SIZE=24
EOF

# ---------------------------------------------------------------- boot look
plymouth-set-default-theme tenka-samurai || true
mkdir -p /etc/default/grub.d
cat > /etc/default/grub.d/90-tenka.cfg <<'EOF'
GRUB_DISTRIBUTOR="Tenka"
GRUB_THEME="/usr/share/grub/themes/tenka-samurai/theme.txt"
GRUB_GFXMODE=1920x1080,1280x720,auto
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=0 rd.systemd.show_status=false systemd.show_status=false rd.udev.log_level=0 udev.log_priority=0 vt.global_cursor_default=0"
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
EOF
# the text console wears the theme too: Samurai's 16 colours (gen-themes.py) + a larger bold Terminus
VT=$(cat /usr/share/tenka/themes/samurai/console.vt 2>/dev/null || true)
[ -n "$VT" ] && sed -i "s|vt.global_cursor_default=0|vt.global_cursor_default=0 $VT|" /etc/default/grub.d/90-tenka.cfg
if [ -f /etc/default/console-setup ]; then
  sed -i -e 's/^FONTFACE=.*/FONTFACE="TerminusBold"/' -e 's/^FONTSIZE=.*/FONTSIZE="12x24"/' /etc/default/console-setup
fi

# ---------------------------------------------------------------- installer
if [ -f /etc/calamares/settings.conf ]; then
  sed -i 's/^branding:.*/branding: tenka-samurai/' /etc/calamares/settings.conf
  # keep the live session's path (Samurai or Xianxia) on the installed system: one step after users,
  # before the GRUB and initramfs steps (usr/libexec/tenka/tenka-install-path)
  if ! grep -q 'shellprocess@tenka-path' /etc/calamares/settings.conf; then
    awk '/^- exec:/{e=1} e && /^  - users$/ && !d {print; print "  - shellprocess@tenka-path"; d=1; next} {print}' \
      /etc/calamares/settings.conf > /tmp/cal.conf && cat /tmp/cal.conf > /etc/calamares/settings.conf && rm -f /tmp/cal.conf
    printf 'instances:\n- id: tenka-path\n  module: shellprocess\n  config: shellprocess-tenka-path.conf\n' >> /etc/calamares/settings.conf
  fi
fi
for f in /usr/share/applications/calamares-install-debian.desktop /etc/skel/Desktop/calamares-install-debian.desktop; do
  [ -f "$f" ] && sed -i -e 's/^Name=.*/Name=Install Tenka/' -e 's/^Name\[[^]]*\]=.*//' -e 's/^Icon=.*/Icon=tenka/' -e 's/^Comment=.*/Comment=Put Tenka on this computer/' "$f"
done

# ---------------------------------------------------------------- Qt look for root apps
# The installer runs as root through pkexec (no qt6ct there), so give root the same
# Kvantum theme the desk uses and ask for it by name.
for t in /usr/share/tenka/themes/*/home/.config/Kvantum/Tenka-*; do
  [ -d "$t" ] && mkdir -p "/usr/share/Kvantum/$(basename "$t")" && cp -rT "$t" "/usr/share/Kvantum/$(basename "$t")"
done
install -d /root/.config/Kvantum
# the solid twin: the installer must read cleanly on Tenka Lite too, where nothing blurs behind it
printf '[General]\ntheme=Tenka-SamuraiSolid\n' > /root/.config/Kvantum/kvantum.kvconfig
# (as Qt's own -style argument: "pkexec env QT_STYLE_OVERRIDE=... calamares" ran /usr/bin/env, i.e. pkexec's generic
# action without calamares' allow_gui, so pkexec dropped DISPLAY/XAUTHORITY and the installer never opened)
# The root side is /usr/libexec/tenka/tenka-installer (its own polkit action, allow_gui): it adds -style kvantum and, under
# pure CPU emulation, the llvmpipe settings pkexec would otherwise strip (Calamares segfaulted in a TCG VM without them)
[ -f /usr/bin/calamares-install-debian ] && sed -i 's|^pkexec calamares$|pkexec /usr/libexec/tenka/tenka-installer|' /usr/bin/calamares-install-debian

# ---------------------------------------------------------------- user defaults
grep -q 'bashrc.d' /etc/skel/.bashrc || cat >> /etc/skel/.bashrc <<'EOF'

# Tenka
for f in ~/.bashrc.d/*.sh; do [ -r "$f" ] && . "$f"; done
EOF
mkdir -p /etc/firefox-esr
cat > /etc/firefox-esr/tenka.js <<'EOF'
// Tenka defaults: quiet, smooth, lean on old hardware
pref("toolkit.telemetry.enabled", false);
pref("datareporting.healthreport.uploadEnabled", false);
pref("datareporting.policy.dataSubmissionEnabled", false);
pref("browser.newtabpage.activity-stream.feeds.section.topstories", false);
pref("browser.newtabpage.activity-stream.showSponsoredTopSites", false);
pref("general.smoothScroll.msdPhysics.enabled", true);
pref("browser.sessionstore.interval", 60000);
pref("browser.cache.disk.capacity", 262144);
pref("browser.theme.toolbar-theme", 0);
pref("layout.css.prefers-color-scheme.content-override", 0);
EOF

# The Lite dock groups a running window with its pinned launcher by WM_CLASS. Mousepad and Ristretto ship
# reverse-DNS desktop ids (org.xfce.*) with no StartupWMClass, so an open editor showed up as a second, unpinned
# pencil beside its own launcher. Name the class they actually set.
for pair in org.xfce.mousepad:mousepad org.xfce.ristretto:ristretto; do
  f=/usr/share/applications/${pair%%:*}.desktop
  [ -f "$f" ] && ! grep -q '^StartupWMClass=' "$f" && sed -i "0,/^\[Desktop Entry\]/s//[Desktop Entry]\nStartupWMClass=${pair#*:}/" "$f"
done

# The desktop and launcher menus: no mail client ships, so drop "Mail Reader" (it only opened an app picker), and
# give the three preferred-app entries short names: Terminal, Files, Browser
sed -i '/xfce4-mail-reader\.desktop/d' /etc/xdg/menus/xfce-applications.menu 2>/dev/null || true
[ -f /usr/share/applications/xfce4-mail-reader.desktop ] && { grep -q '^NoDisplay=' /usr/share/applications/xfce4-mail-reader.desktop || sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' /usr/share/applications/xfce4-mail-reader.desktop; }
# Preferred apps (Settings > Default Applications, exo-open): Debian's helpers.rc names Thunderbird, which does not ship,
# and generic Debian wrappers; name what is really here. Hyprland reads /etc/xdg/tenka-hyprland first (kitty).
sed -i -e '/^MailReader=/d' -e 's/^WebBrowser=.*/WebBrowser=firefox/' -e 's/^TerminalEmulator=.*/TerminalEmulator=xfce4-terminal/' /etc/xdg/xfce4/helpers.rc 2>/dev/null || true
for pair in xfce4-terminal-emulator:Terminal xfce4-file-manager:Files xfce4-web-browser:Browser; do
  f=/usr/share/applications/${pair%%:*}.desktop
  [ -f "$f" ] && sed -i -e "s/^Name=.*/Name=${pair#*:}/" -e 's/^Name\[[^]]*\]=.*//' "$f"
done

# One short name per app, the same in the dock's tooltips, the launcher and the menus: Terminal, Files, Editor,
# Firefox, Player (the dock showed "Xfce Terminal", "Thunar File Manager", "mpv Media Player"). Only the main entry's
# Name changes; the old name moves into Keywords so typing "thunar" or "mousepad" still finds it. The XFCE
# wrapper entries that already said Terminal and Files are hidden so each app is listed once, and the desktop
# menu's top three point at the real apps.
rename_app() {   # $1 desktop id, $2 the new name; the old name moves into Keywords
  f=/usr/share/applications/$1.desktop; [ -f "$f" ] || return 0
  grep -qx "Name=$2" "$f" && return 0
  awk -v new="$2" '
    /^\[/ { main = ($0 == "[Desktop Entry]") }
    main && /^Name=/ { old = substr($0, 6); lines[++n] = "Name=" new; next }
    main && /^Name\[/ { next }
    main && /^Keywords=/ { kw = 1 }
    { lines[++n] = $0 }
    END { for (i = 1; i <= n; i++) { l = lines[i]
            if (l ~ /^Keywords=/ && !done) { sub(/^Keywords=/, "Keywords=" old ";", l); done = 1 }
            print l
            if (l == "[Desktop Entry]" && !kw) { print "Keywords=" old ";"; done = 1 } } }' "$f" > "$f.new" && mv "$f.new" "$f"
}
for pair in xfce4-terminal:Terminal thunar:Files firefox-esr:Firefox org.xfce.mousepad:Editor mpv:Player; do
  rename_app "${pair%%:*}" "${pair#*:}"
done
# The rest of the menus in the same voice: no "Xfce", "Thunar", "Ristretto" or "btop++" left in a name
rename_app org.xfce.ristretto "Images"
rename_app btop "System Monitor"
rename_app nm-connection-editor "Network"
rename_app xfce4-screensaver-preferences "Lock Screen"
rename_app xfce4-terminal-settings "Terminal Settings"
rename_app thunar-settings "Files Settings"
rename_app org.xfce.mousepad-settings "Editor Settings"
# Not apps a person opens from Lite's menus: conky (the desk widget daemon) and vim (Editor is the editor) everywhere;
# the Hyprland session's own terminal and Qt/GTK tools stay out of the XFCE menus
for w in conky vim; do
  f=/usr/share/applications/$w.desktop
  [ -f "$f" ] && ! grep -q '^NoDisplay=' "$f" && sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' "$f"
done
for w in kitty nwg-look qt6ct kvantummanager; do
  f=/usr/share/applications/$w.desktop; [ -f "$f" ] || continue
  if grep -q '^NotShowIn=' "$f"; then grep -q '^NotShowIn=.*XFCE' "$f" || sed -i 's/^NotShowIn=/NotShowIn=XFCE;/' "$f"
  else sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNotShowIn=XFCE;/' "$f"; fi
done
for w in xfce4-terminal-emulator xfce4-file-manager; do
  f=/usr/share/applications/$w.desktop
  [ -f "$f" ] && ! grep -q '^NoDisplay=' "$f" && sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' "$f"
done
m=/etc/xdg/menus/xfce-applications.menu
if [ -f "$m" ] && ! grep -q '<Filename>thunar.desktop</Filename>' "$m"; then
  sed -i -e 's|<Category>X-Xfce-Toplevel</Category>|&\n        <Filename>xfce4-terminal.desktop</Filename>\n        <Filename>thunar.desktop</Filename>|' \
         -e 's|<Filename>xfce4-terminal-emulator.desktop</Filename>|<Filename>xfce4-terminal.desktop</Filename>|' \
         -e 's|<Filename>xfce4-file-manager.desktop</Filename>|<Filename>thunar.desktop</Filename>|' "$m"
fi

# Lite: the Tenka GTK themes sit on Orchis-Dark; give each a copy of that base with its blue accent turned to the
# theme's gold (the sed list comes from scripts/gen-lite.py) and import the copy. If anything fails, the theme keeps
# importing Orchis as it is.
o=/usr/share/themes/Orchis-Dark/gtk-3.0/gtk.css
for t in /usr/share/themes/Tenka-*/gtk-3.0; do
  [ -f "$o" ] && [ -f "$t/orchis-recolor.sed" ] || continue
  if sed -f "$t/orchis-recolor.sed" "$o" > "$t/base.css.new" && [ -s "$t/base.css.new" ]; then
    mv "$t/base.css.new" "$t/base.css"
    for f in gtk.css gtk-dark.css; do
      [ -f "$t/$f" ] && sed -i 's|@import url("../../Orchis-Dark/gtk-3.0/gtk.css");|@import url("base.css");|' "$t/$f"
    done
  else rm -f "$t/base.css.new"; fi
done

fc-cache -f >/dev/null 2>&1 || true
update-initramfs -u -k all || true
