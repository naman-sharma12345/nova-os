# Tenka: what opens when you double-click a file. Without this, Debian picked by accident: photos opened in Firefox,
# text files in Neovim with no terminal, and Markdown in nothing. Each kind now opens in the app the dock and launcher
# name for it: Images (Ristretto), Notes (Mousepad), Player (mpv), Reader (Zathura), Archives (File Roller), Firefox.
# A person's own choice (Open With > set as default) writes ~/.config/mimeapps.list, which wins over this file.
[Default Applications]
image/jpeg=org.xfce.ristretto.desktop;imv.desktop;
image/png=org.xfce.ristretto.desktop;imv.desktop;
