#!/bin/sh
# tenka-seal-lite: Tenka Lite's polkit agent. The Seal (the flagship's prompt card) through Quickshell's own polkit
# agent in a small X11 window (/usr/share/tenka/seal-lite). If it has not registered within 15 s, or stops, the
# stock hyprpolkitagent takes over, so an administrator prompt is never left without an answer.
rt=${XDG_RUNTIME_DIR:-/tmp}
rm -f "$rt/tenka-seal"
if command -v qs >/dev/null 2>&1 && [ -f /usr/share/tenka/seal-lite/shell.qml ]; then
    qs -p /usr/share/tenka/seal-lite >/dev/null 2>&1 &
    pid=$!
    i=0
    while [ $i -lt 15 ] && kill -0 "$pid" 2>/dev/null && [ ! -e "$rt/tenka-seal" ]; do sleep 1; i=$((i+1)); done
    if [ -e "$rt/tenka-seal" ]; then wait "$pid"; fi     # ours: stay with it while it lives
    kill "$pid" 2>/dev/null
    rm -f "$rt/tenka-seal"
fi
for a in /usr/libexec/hyprpolkitagent /usr/lib/hyprpolkitagent/hyprpolkitagent /usr/lib/x86_64-linux-gnu/libexec/hyprpolkitagent; do
    [ -x "$a" ] && exec "$a"
done
