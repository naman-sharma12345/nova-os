#!/bin/sh
# tenka-perf on|off|toggle|status: Performance mode. Motion, blur and shadows off; all the art stays.
F="$HOME/.config/hypr/perf.lua"; S="$HOME/.config/tenka/perf"
mkdir -p "$HOME/.config/tenka" "$HOME/.config/hypr" "$HOME/.config/kitty"
state() { [ -e "$S" ] && echo on || echo off; }
case "${1:-status}" in
  status) state; exit 0 ;;
  toggle) [ "$(state)" = on ] && set -- off || set -- on ;;
esac
if [ "$1" = on ]; then
  touch "$S"
  cat > "$F" <<'EOF'
-- written by tenka-perf: performance mode
hl.config({
    general = { gaps_in = 3, gaps_out = 6 },
    decoration = { blur = { enabled = false }, shadow = { enabled = false }, inactive_opacity = 1.0 },
    animations = { enabled = false },
})
EOF
  command -v xfconf-query >/dev/null && { xfconf-query -c xfwm4 -p /general/show_frame_shadow -s false; xfconf-query -c xfwm4 -p /general/show_popup_shadow -s false; xfconf-query -c xfwm4 -p /general/box_move -s true; } 2>/dev/null
  # no blur behind glass: the terminal and the file manager go denser so text never reads through
  printf '# written by tenka-perf: performance mode\nbackground_opacity 0.96\n' > "$HOME/.config/kitty/perf.conf" 2>/dev/null
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    mkdir -p "$HOME/.cache/tenka"; cp -f "/usr/share/tenka/themes/$(tenka-theme --current)/lite-session.css" "$HOME/.cache/tenka/session.css" 2>/dev/null
  fi
  msg="Performance mode on: motion and blur rest, the art stays."
else
  rm -f "$S" "$F"
  command -v xfconf-query >/dev/null && { xfconf-query -c xfwm4 -p /general/show_frame_shadow -s true; xfconf-query -c xfwm4 -p /general/show_popup_shadow -s true; xfconf-query -c xfwm4 -p /general/box_move -s false; } 2>/dev/null
  printf '# written by tenka-perf (empty = full glass)\n' > "$HOME/.config/kitty/perf.conf" 2>/dev/null
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && rm -f "$HOME/.cache/tenka/session.css"
  msg="Performance mode off: full motion and glass."
fi
[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && hyprctl reload >/dev/null 2>&1
# only with a desktop up: tenka-hyprland-session runs this before Hyprland exists, and a notify-send there
# would D-Bus-activate mako (and can block the session start while that activation times out)
[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ] && notify-send -a Tenka "Tenka" "$msg" 2>/dev/null
exit 0
