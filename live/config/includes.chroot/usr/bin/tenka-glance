#!/usr/bin/python3
"""tenka-glance: The Glance (Tianxia: The Glimpse), a quick look at files without opening them.

  tenka-glance FILE [FILE ...]   show the files one at a time in a flat themed card: a picture, the first
                                 page of a PDF, a frame of a video, the opening lines of a text, what a folder
                                 holds, or the facts of anything else. ← → move between them, Enter opens one in
                                 its own app, ESC or Ctrl+Space closes. Thunar's "Glance" action (Ctrl+Space) calls it.
  tenka-glance --facts FILE ...  print the facts JSON and leave (the tests' and the renders' door)
The previews are made in a private (0700) runtime folder and removed when the card closes.
"""
import json, mimetypes, os, shutil, stat, subprocess, sys, threading, time

TEXT_EXT = {".txt", ".md", ".py", ".sh", ".rs", ".c", ".h", ".cpp", ".js", ".ts", ".json", ".toml", ".yaml", ".yml",
            ".ini", ".conf", ".cfg", ".lua", ".qml", ".css", ".html", ".xml", ".csv", ".log", ".desktop", ".go", ".java"}

def human(n):
    for u in ("bytes", "KB", "MB", "GB", "TB"):
        if n < 1024 or u == "TB":
            return (f"{n} {u}" if u == "bytes" else f"{n:.1f} {u}".replace(".0 ", " "))
        n /= 1024

def kind_of(path):
    if os.path.isdir(path): return "folder"
    mime = mimetypes.guess_type(path)[0] or ""
    ext = os.path.splitext(path)[1].lower()
    if mime == "application/pdf": return "pdf"
    if mime.startswith("image/") and ext not in (".xcf", ".psd"): return "image"
    if mime.startswith("video/"): return "video"
    if mime.startswith("audio/"): return "audio"
    if mime.startswith("text/") or ext in TEXT_EXT or os.path.basename(path).lower() in ("readme", "license", "makefile"): return "text"
    try:
        with open(path, "rb") as f: head = f.read(4096)
        if head and b"\0" not in head:
            head.decode("utf-8"); return "text"
    except (OSError, UnicodeDecodeError):
        pass
    return "other"

def picture_size(path):
    """width and height from the file's own header (PNG, JPEG, GIF, WebP), without an imaging library"""
    import struct
    try:
        with open(path, "rb") as fh: h = fh.read(32)
        if h[:8] == b"\x89PNG\r\n\x1a\n": return struct.unpack(">II", h[16:24])
        if h[:6] in (b"GIF87a", b"GIF89a"): return struct.unpack("<HH", h[6:10])
        if h[:4] == b"RIFF" and h[8:12] == b"WEBP":
            if h[12:16] == b"VP8X": return (int.from_bytes(h[24:27], "little") + 1, int.from_bytes(h[27:30], "little") + 1)
            with open(path, "rb") as fh: d = fh.read(30)
            if d[12:16] == b"VP8 ": w, hh = struct.unpack("<HH", d[26:30]); return (w & 0x3fff, hh & 0x3fff)
        if h[:2] == b"\xff\xd8":
            with open(path, "rb") as fh:
                fh.read(2)
                while True:
                    b = fh.read(1)
                    while b and b != b"\xff": b = fh.read(1)
                    while b == b"\xff": b = fh.read(1)
                    if not b: break
                    m = b[0]
                    if m in (0xd8, 0x01) or 0xd0 <= m <= 0xd7: continue
                    ln = struct.unpack(">H", fh.read(2))[0]
                    if m in (0xc0, 0xc1, 0xc2, 0xc3, 0xc5, 0xc6, 0xc7, 0xc9, 0xca, 0xcb, 0xcd, 0xce, 0xcf):
                        hh, w = struct.unpack(">xHH", fh.read(5)); return (w, hh)
                    fh.seek(ln - 2, 1)
    except (OSError, struct.error):
        pass
    return None

WORD = {"folder": "Folder", "pdf": "PDF document", "image": "Picture", "video": "Video", "audio": "Sound",
        "text": "Text", "other": "File"}

def facts(path):
    st = os.stat(path)
    k = kind_of(path)
    f = {"path": path, "name": os.path.basename(path.rstrip("/")) or path, "kind": k, "word": WORD[k],
         "mime": mimetypes.guess_type(path)[0] or ("inode/directory" if k == "folder" else ""),
         "size": "" if k == "folder" else human(st.st_size), "mtime": int(st.st_mtime), "preview": "", "lines": "",
         "items": [], "count": -1, "extra": "", "ready": k in ("image", "other")}
    if k == "image":
        wh = picture_size(path)
        if wh: f["extra"] = f"{wh[0]} × {wh[1]}"
    if k == "text":
        try:
            with open(path, "rb") as fh: raw = fh.read(16384)
            t = raw.decode("utf-8", "replace").replace("\t", "    ")
            f["lines"] = "\n".join(t.splitlines()[:60])
        except OSError: pass
        f["ready"] = True
    elif k == "folder":
        try:
            es = sorted(os.scandir(path), key=lambda e: (not e.is_dir(follow_symlinks=False), e.name.lower()))
            vis = [e for e in es if not e.name.startswith(".")]
            f["count"] = len(vis)
            f["items"] = [{"name": e.name, "dir": e.is_dir()} for e in vis[:16]]
        except OSError: pass
        f["ready"] = True
    return f

def make_preview(f, out, i):
    """the slow previews, made after the card is up: a PDF's first page, a video's frame, a sound's facts"""
    p = f["path"]
    try:
        if f["kind"] == "pdf" and shutil.which("pdftoppm"):
            base = os.path.join(out, f"p{i}")
            subprocess.run(["pdftoppm", "-png", "-r", "70", "-f", "1", "-l", "1", "-singlefile", p, base],
                           capture_output=True, timeout=20)
            if os.path.exists(base + ".png"): f["preview"] = base + ".png"
            info = subprocess.run(["pdfinfo", p], capture_output=True, text=True, timeout=10).stdout
            pages = next((l.split(":", 1)[1].strip() for l in info.splitlines() if l.startswith("Pages:")), "")
            if pages: f["extra"] = pages + (" page" if pages == "1" else " pages")
        elif f["kind"] in ("video", "audio") and shutil.which("mpv"):
            d = os.path.join(out, f"v{i}"); os.makedirs(d, exist_ok=True)
            cmd = ["mpv", "--no-config", "--really-quiet", "--ao=null", "--msg-level=all=no,term-msg=info",
                   "--term-playing-msg=TENKA ${=duration}|${metadata/by-key/title:}|${metadata/by-key/artist:}"]
            if f["kind"] == "video":
                cmd += ["--vo=image", "--vo-image-format=png", f"--vo-image-outdir={d}", "--frames=1", "--start=12%"]
            else:
                cmd += ["--vo=null", "--frames=1"]
            r = subprocess.run(cmd + ["--", p], capture_output=True, text=True, timeout=25)
            line = next((l for l in r.stdout.splitlines() if l.startswith("TENKA ")), "")
            if line:
                dur, title, artist = (line[6:].split("|") + ["", ""])[:3]
                try:
                    s = int(float(dur)); f["extra"] = (f"{s // 3600}:{s // 60 % 60:02d}:{s % 60:02d}" if s >= 3600 else f"{s // 60}:{s % 60:02d}")
                except ValueError: pass
                f["title"], f["artist"] = title, artist
            shots = sorted(x for x in os.listdir(d) if x.endswith(".png"))
            if shots: f["preview"] = os.path.join(d, shots[0])
    except (OSError, subprocess.SubprocessError):
        pass
    f["ready"] = True

def put(path, g):
    fd = os.open(path + ".part", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh: json.dump(g, fh, ensure_ascii=False)
    os.replace(path + ".part", path)

def main():
    a = [x for x in sys.argv[1:] if x]
    only = "--facts" in a
    paths = [os.path.abspath(x[7:] if x.startswith("file://") else x) for x in a if x != "--facts"]
    paths = [p for p in paths if os.path.exists(p)][:60]
    if not paths:
        print("usage: tenka-glance FILE [FILE ...]", file=sys.stderr); return 2
    g = {"items": [facts(p) for p in paths], "at": 0}
    rt = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    out = os.path.join(rt, f"tenka-glance-{os.getpid()}")
    os.makedirs(out, mode=0o700, exist_ok=True)
    if only:
        for i, f in enumerate(g["items"]):
            if not f["ready"]: make_preview(f, out, i)
        print(json.dumps(g, ensure_ascii=False)); return 0
    lock = os.path.join(rt, "tenka-glance.pid")      # one card at a time: a second Glance replaces the first
    try:
        pid = int(open(lock).read().strip())
        if b"Glance.qml" in open(f"/proc/{pid}/cmdline", "rb").read(): os.kill(pid, 15)
    except (OSError, ValueError):
        pass
    fpath = os.path.join(out, "facts.json")
    put(fpath, g)
    theme = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "tenka", "shell-theme.json")
    env = dict(os.environ, QML_XHR_ALLOW_FILE_READ="1", QT_MESSAGE_PATTERN="%{message}")
    if not env.get("WAYLAND_DISPLAY"): env["QT_QPA_PLATFORM"] = "xcb"
    p = subprocess.Popen(["/usr/lib/qt6/bin/qml", "/usr/share/tenka/glance/Glance.qml", "--", fpath, theme],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
    with open(lock, "w") as fh: fh.write(str(p.pid))
    lk = threading.Lock()
    def work():
        for i, f in enumerate(g["items"]):
            if p.poll() is not None: return
            if not f["ready"]:
                make_preview(f, out, i)
                with lk: put(fpath, g)
    threading.Thread(target=work, daemon=True).start()
    p.wait()
    shutil.rmtree(out, ignore_errors=True)
    try:
        if open(lock).read().strip() == str(p.pid): os.remove(lock)
    except OSError:
        pass
    return 0

if __name__ == "__main__":
    sys.exit(main())
