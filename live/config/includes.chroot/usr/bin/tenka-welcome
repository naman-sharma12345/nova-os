#!/bin/sh
# First-login welcome and theme picker.
mkdir -p "$HOME/.config/tenka"
set --
# performance mode already on (Hyprland on a software renderer turns it on at login): the switch starts ticked and
# the note says why, instead of showing an unticked box over a desktop that is already in performance mode
perfon=; [ -e "$HOME/.config/tenka/perf" ] && perfon=1
if [ "$(cat /run/tenka/mode 2>/dev/null)" = lite ] || [ "${XDG_CURRENT_DESKTOP:-}" = XFCE ] || { [ "${XDG_CURRENT_DESKTOP:-}" = Hyprland ] && [ -n "$perfon" ]; }; then
  r=$(sed -n 's/^reason: //p' /run/tenka-hwdetect.reason 2>/dev/null)
  case "$(sed -n 's/^renderer: //p' /run/tenka-hwdetect.reason 2>/dev/null)" in *llvmpipe*|*softpipe*|none) r="no 3D graphics" ;; esac
  case "$r" in
    *3D*|*3d*|*llvmpipe*|*software*) r="no 3D graphics" ;;
    *RAM*|*memory*|*Memory*) r="under 4 GB of memory" ;;
    ""|*chosen*) r="light hardware" ;;
  esac
  set -- --lite --reason "$r"
  [ "${XDG_CURRENT_DESKTOP:-}" = Hyprland ] && set -- "$@" --hypr
fi
QML=$(command -v qml6 || echo /usr/lib/qt6/bin/qml)
# RESOURCE_NAME names the window (WM_CLASS) so docks show the theme icon, not a generic one
# its complaints go to a log, not to nowhere, so a welcome that never showed can be explained
mkdir -p "$HOME/.cache/tenka"
QT_QPA_PLATFORMTHEME= RESOURCE_NAME=tenka-welcome "$QML" /usr/share/tenka/welcome/Welcome.qml -- "$@" 2>"$HOME/.cache/tenka/welcome.log"
rc=$?
# only a welcome that actually ran and was closed counts as seen; a crash (or a missing Qt module)
# leaves the flag unset so it comes back at the next login instead of never appearing again
case $rc in
  0|10|11|20|21) touch "$HOME/.config/tenka/welcomed" ;;
  *) echo "tenka-welcome: qml exited $rc" >>"$HOME/.cache/tenka/welcome.log"; exit "$rc" ;;
esac
# unticking the switch over a desktop that started in performance mode turns it off
[ -n "$perfon" ] && [ "${XDG_CURRENT_DESKTOP:-}" = Hyprland ] && case $rc in 10|11) tenka-perf off ;; esac
case $rc in
  10) tenka-theme samurai ;; 11) tenka-theme xianxia ;;
  20) tenka-perf on; tenka-theme samurai ;; 21) tenka-perf on; tenka-theme xianxia ;;
esac
