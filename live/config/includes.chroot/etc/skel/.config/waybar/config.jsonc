// Tenka · waybar. Theme-specific modules live in theme.jsonc (swapped by tenka-theme).
{
  "include": ["~/.config/waybar/theme.jsonc"],
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 10,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 6,
  "reload_style_on_change": true,
  "modules-left": ["custom/crest", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["custom/clock"],
  "modules-right": ["tray", "pulseaudio", "network", "battery", "custom/power"],

  "hyprland/window": { "max-length": 42, "separate-outputs": true, "format": "{title}" },
  "custom/clock": {
    "exec": "tenka-clock --waybar",
    "return-type": "json",
    "interval": 20,
    "on-click": "tenka-clock --notify"
  },
  "tray": { "icon-size": 16, "spacing": 10 },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 online",
    "format-disconnected": "󰤭 offline",
    "tooltip-format": "{ifname} · {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "states": { "warning": 20 }
  },
  "custom/power": { "format": "⏻", "tooltip": false, "on-click": "tenka-power" }
}
