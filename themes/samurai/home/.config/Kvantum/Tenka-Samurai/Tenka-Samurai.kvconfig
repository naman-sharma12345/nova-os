[%General]
author=Tenka (generated by scripts/gen-themes.py)
comment=Tenka Samurai washi glass: flat ink, one accent, no glow
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=4
composite=true
translucent_windows=true
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,VirtualBoxVM,trojita,dragon,digikam,lyx,mpv,obs,krita,qemu-system-x86_64
blurring=false
popup_blurring=false
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=true
menu_separator_height=7
splitter_width=7
scroll_width=8
scroll_min_extent=40
scroll_arrows=false
transient_scrollbar=true
transient_groove=true
combo_as_lineedit=true
combo_menu=true
inline_spin_indicators=true
vertical_spin_indicators=false
slider_width=4
slider_handle_width=16
slider_handle_length=16
check_size=16
tooltip_delay=600
toolbar_icon_size=22
small_icon_size=16
large_icon_size=32
button_icon_size=16
layout_spacing=6
layout_margin=8
dark_titlebar=true
animate_states=true
no_inactiveness=true
reduce_window_opacity=0
reduce_menu_opacity=0
fill_rubberband=false
menubar_mouse_tracking=true
respect_DE=false
click_behavior=1
submenu_overlap=0
shadowless_popup=true

[GeneralColors]
window.color=#0f0d0c99
base.color=#0a09085c
alt.base.color=#12100f70
button.color=#1b1816
light.color=#423c38
mid.light.color=#2a2522
dark.color=#0a09088c
mid.color=#221e1c
highlight.color=#922f23
inactive.highlight.color=#6b251c
tooltip.base.color=#0a0908
text.color=#efe6d6
window.text.color=#efe6d6
button.text.color=#efe6d6
disabled.text.color=#6c6458
tooltip.text.color=#efe6d6
highlight.text.color=#efe6d6
link.color=#c9a35a
link.visited.color=#f2a7b5
progress.indicator.text.color=#efe6d6

[Hacks]
transparent_dolphin_view=false
blur_konsole=false
transparent_ktitle_label=true
respect_darkness=true
force_size_grip=false
tint_on_mouseover=0
no_selection_tint=true
centered_forms=false
kcapacitybar_as_progressbar=true
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=60
lxqtmainmenu_iconsize=22
normal_default_pushbutton=true
transparent_menutitle=true
middle_click_scroll=false
scroll_jump_workaround=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=button
indicator.size=10
indicator.element=arrow
text.normal.color=#efe6d6
text.focus.color=#efe6d6
text.press.color=#efe6d6
text.toggle.color=#efe6d6
text.disabled.color=#6c6458
text.shadow=1
text.shadow.xshift=0
text.shadow.yshift=1
text.shadow.color=#000000
text.shadow.alpha=150
text.shadow.depth=1
text.margin=1
text.iconspacing=6
text.margin.left=10
text.margin.right=10
text.margin.top=4
text.margin.bottom=4
min_width=+0.3font
min_height=+0.3font
frame.expansion=0

