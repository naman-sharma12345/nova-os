#!/bin/bash
# Root half of tenka-theme: boot splash, GRUB, SDDM, os-release, installer branding.
set -u
T="$1"; case "$T" in samurai|xianxia) ;; *) exit 1 ;; esac
D=/usr/share/tenka/themes/$T
. "$D/theme.env"
mkdir -p /etc/tenka; echo "$T" > /etc/tenka/theme

# os-release: the display name follows the theme
sed -i -e "s/^NAME=.*/NAME=\"$THEME_DISPLAY\"/" \
       -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"$THEME_DISPLAY $(. /usr/lib/os-release; echo $VERSION_ID) · $THEME_TAGLINE\"/" /usr/lib/os-release

# SDDM greeter
mkdir -p /etc/sddm.conf.d
printf '[Theme]\nCurrent=tenka-%s\nCursorTheme=%s\nCursorSize=24\nFont=Marcellus\n' "$T" "$THEME_CURSOR" > /etc/sddm.conf.d/20-tenka-theme.conf

# installer branding (live session)
[ -f /etc/calamares/settings.conf ] && sed -i "s/^branding:.*/branding: tenka-$T/" /etc/calamares/settings.conf

# GRUB (installed systems)
if [ -d /boot/grub ] && command -v update-grub >/dev/null && [ ! -d /run/live ]; then
  mkdir -p /etc/default/grub.d
  F=/etc/default/grub.d/90-tenka.cfg
  # edit in place: keep the quiet/splash kernel line and timeout the installer wrote
  [ -f "$F" ] || printf 'GRUB_GFXMODE=1920x1080,1280x720,auto\n' > "$F"
  sed -i -e '/^GRUB_THEME=/d' -e '/^GRUB_DISTRIBUTOR=/d' "$F"
  printf 'GRUB_THEME="/usr/share/grub/themes/tenka-%s/theme.txt"\nGRUB_DISTRIBUTOR="%s"\n' "$T" "$THEME_DISPLAY" >> "$F"
  VT=$(cat "$D/console.vt" 2>/dev/null)
  if [ -n "$VT" ] && grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' "$F"; then
    sed -i -e '/^GRUB_CMDLINE_LINUX_DEFAULT=/{s/ *vt\.default_\(red\|grn\|blu\)=[0-9,]*//g' -e "s/\"\$/ $VT\"/}" "$F"
  fi
  update-grub >/dev/null 2>&1
fi

# text console colours, now (the GRUB line above carries them from the next boot)
if [ -f "$D/console.vt" ] && command -v setvtrgb >/dev/null; then
  tr ' ' '\n' < "$D/console.vt" | sed -n 's/^vt\.default_[a-z]*=//p' > /run/tenka-vtrgb && setvtrgb /run/tenka-vtrgb 2>/dev/null
fi

# Plymouth (rebuilds the initramfs on installed systems)
if command -v plymouth-set-default-theme >/dev/null; then
  # live session, or the installer (its own initramfs step runs right after): set the theme, skip the rebuild
  if [ -d /run/live ] || [ -n "${TENKA_INSTALLING:-}" ]; then plymouth-set-default-theme "tenka-$T"
  else plymouth-set-default-theme -R "tenka-$T" >/dev/null 2>&1; fi
fi
exit 0
