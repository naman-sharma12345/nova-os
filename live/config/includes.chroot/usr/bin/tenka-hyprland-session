#!/bin/sh
export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland XDG_SESSION_TYPE=wayland
# software GL is allowed (slow) so a VM without 3D still gets a desktop
export WLR_RENDERER_ALLOW_SOFTWARE=1
# pure CPU emulation: 128-bit llvmpipe vectors (the emulated AVX2 path crashes; written at boot by tenka-session-default)
# and no AVX at all: 128-bit code still used AVX2 instructions and Hyprland kept crashing in it (nightly #17);
# capping llvmpipe at SSE4.1 matches the emulated CPU that ran clean (Westmere)
[ -e /run/tenka/emulated ] && export LP_NATIVE_VECTOR_WIDTH=128 GALLIUM_OVERRIDE_CPU_CAPS=sse4.1
# performance mode on software rendering: when the machine was judged lite, and also when Hyprland was
# chosen at boot (tenka.session=hyprland skips the probe) on a machine whose only renderer is llvmpipe
soft=0
[ "$(cat /run/tenka/mode 2>/dev/null)" = lite ] && soft=1
# (the renderer comes from the boot probe, which runs as root; a probe from inside the session can come back
# empty before the compositor holds the GPU, and empty means no hardware renderer)
if [ "$soft" = 0 ] && grep -q 'chosen at boot' /run/tenka-hwdetect.reason 2>/dev/null; then
  r=$(sed -n 's/^renderer: //p' /run/tenka-hwdetect.reason)
  [ -z "$r" ] && r=$(timeout 5 eglinfo -B -p gbm 2>/dev/null | grep -i -m1 'renderer')
  case "$r" in *llvmpipe*|*softpipe*|*lavapipe*|""|none) soft=1 ;; esac
fi
[ "$soft" = 1 ] && [ ! -e "$HOME/.config/tenka/perf" ] && tenka-perf on >/dev/null 2>&1
command -v start-hyprland >/dev/null && exec start-hyprland
exec Hyprland
