#!/usr/bin/python3
# tenka-bond-agent: the Bluetooth pairing agent for the Hyprland session, so devices that want a PIN, a
# passkey or a yes can pair. BlueZ asks this agent (org.bluez.Agent1, KeyboardDisplay); the agent writes the
# question to $XDG_RUNTIME_DIR/tenka-bond/ask.json and calls the shell (`qs -c tenka ipc call bluetooth ask`),
# so the prompt appears inside The Bond (Bond.qml) in the house style, never as a foreign dialog. The Bond
# answers through `tenka-bond-agent answer`, which reads "<id> <value>" on stdin (a PIN never rides a command
# line) and leaves it in a 0600 file the agent picks up. Unanswered questions are cancelled after 60 s.
# Lite runs blueman-applet instead. TENKA_BOND_BUS=session runs against the session bus (tests).
import json, os, subprocess, sys

RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "tenka-bond")
ASK = os.path.join(RUN, "ask.json")
ANSWER = os.path.join(RUN, "answer")


def private_dir():
    os.makedirs(RUN, mode=0o700, exist_ok=True)
    os.chmod(RUN, 0o700)


def write_private(path, text):
    private_dir()
    tmp = path + ".part"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def answer():
    line = sys.stdin.readline().strip()
    if not line:
        return 2
    write_private(ANSWER, line + "\n")
    return 0


if len(sys.argv) > 1 and sys.argv[1] == "answer":
    sys.exit(answer())

from gi.repository import Gio, GLib  # noqa: E402

PATH = "/org/tenka/bond"
TIMEOUT_MS = 60000
XML = """<node><interface name="org.bluez.Agent1">
 <method name="Release"/>
 <method name="RequestPinCode"><arg type="o" direction="in"/><arg type="s" direction="out"/></method>
 <method name="DisplayPinCode"><arg type="o" direction="in"/><arg type="s" direction="in"/></method>
 <method name="RequestPasskey"><arg type="o" direction="in"/><arg type="u" direction="out"/></method>
 <method name="DisplayPasskey"><arg type="o" direction="in"/><arg type="u" direction="in"/><arg type="q" direction="in"/></method>
 <method name="RequestConfirmation"><arg type="o" direction="in"/><arg type="u" direction="in"/></method>
 <method name="RequestAuthorization"><arg type="o" direction="in"/></method>
 <method name="AuthorizeService"><arg type="o" direction="in"/><arg type="s" direction="in"/></method>
 <method name="Cancel"/>
</interface></node>"""
SERVICES = {"0000110b": "music", "0000110a": "music", "0000111e": "calls", "00001108": "calls",
            "00001124": "keys", "00001112": "calls", "0000110e": "remote", "00001105": "files", "00001106": "files"}

bus = Gio.bus_get_sync(Gio.BusType.SESSION if os.environ.get("TENKA_BOND_BUS") == "session" else Gio.BusType.SYSTEM)
pending = {"id": 0, "inv": None, "kind": "", "timer": 0, "poll": 0}
serial = [int(GLib.get_real_time() // 1000) % 100000]


def device(path):
    try:
        v = bus.call_sync("org.bluez", path, "org.freedesktop.DBus.Properties", "GetAll",
                          GLib.Variant("(s)", ("org.bluez.Device1",)), GLib.VariantType("(a{sv})"),
                          Gio.DBusCallFlags.NONE, 2000, None).unpack()[0]
        return v
    except Exception:
        return {}


def tell(obj):
    write_private(ASK, json.dumps(obj))
    try:
        subprocess.Popen(["qs", "-c", "tenka", "ipc", "call", "bluetooth", "ask"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def settle():
    for k in ("timer", "poll"):
        if pending[k]:
            GLib.source_remove(pending[k])
            pending[k] = 0
    pending["inv"] = None
    pending["kind"] = ""


def finish(err=None, value=None):
    inv = pending["inv"]
    rid = pending["id"]
    settle()
    tell({"id": rid, "kind": "none"})
    if inv is None:
        return
    if err:
        inv.return_dbus_error("org.bluez.Error." + err, err)
    else:
        inv.return_value(value)


def poll():
    try:
        with open(ANSWER) as f:
            line = f.read().strip()
    except OSError:
        return True
    try:
        os.unlink(ANSWER)
    except OSError:
        pass
    rid, _, val = line.partition(" ")
    if rid != str(pending["id"]):
        return True
    kind = pending["kind"]
    pending["poll"] = 0
    if val in ("", "no", "cancel"):
        finish("Rejected" if val == "no" else "Canceled")
    elif kind == "pin":
        finish(value=GLib.Variant("(s)", (val[:16],)))
    elif kind == "passkey":
        if not val.isdigit() or int(val) > 999999:
            pending["poll"] = GLib.timeout_add(120, poll)
            return False
        finish(value=GLib.Variant("(u)", (int(val),)))
    else:
        finish(value=None)
    return False


def expire():
    pending["timer"] = 0
    finish("Canceled")
    return False


def ask(inv, kind, path, code="", service=""):
    if pending["inv"] is not None:          # one question at a time; the older one gives way
        finish("Canceled")
    d = device(path)
    serial[0] += 1
    pending.update(id=serial[0], inv=inv, kind=kind)
    try:
        os.unlink(ANSWER)
    except OSError:
        pass
    name = str(d.get("Alias") or d.get("Name") or d.get("Address") or "a device")
    tell({"id": serial[0], "kind": kind, "name": name, "address": str(d.get("Address", "")),
          "icon": str(d.get("Icon", "")), "code": code, "service": service})
    pending["timer"] = GLib.timeout_add(TIMEOUT_MS, expire)
    if inv is not None:
        pending["poll"] = GLib.timeout_add(120, poll)


def show(kind, path, code, entered=-1):
    # display-only: nothing to answer, the card just shows the code to type on the device
    d = device(path)
    if pending["inv"] is None and pending["kind"] != kind:
        serial[0] += 1
    pending["kind"] = kind
    name = str(d.get("Alias") or d.get("Name") or d.get("Address") or "a device")
    tell({"id": serial[0], "kind": kind, "name": name, "address": str(d.get("Address", "")),
          "icon": str(d.get("Icon", "")), "code": code, "entered": entered})
    if pending["timer"]:
        GLib.source_remove(pending["timer"])
    pending["timer"] = GLib.timeout_add(TIMEOUT_MS, expire)


def on_call(conn, sender, path, iface, method, params, inv):
    a = params.unpack()
    if method == "RequestPinCode":
        ask(inv, "pin", a[0])
    elif method == "RequestPasskey":
        ask(inv, "passkey", a[0])
    elif method == "RequestConfirmation":
        ask(inv, "confirm", a[0], "%06d" % a[1])
    elif method == "RequestAuthorization":
        ask(inv, "authorize", a[0])
    elif method == "AuthorizeService":
        d = device(a[0])
        if d.get("Paired") or d.get("Trusted"):
            inv.return_value(None)          # a device already bonded may use what it pairs for
        else:
            ask(inv, "service", a[0], service=SERVICES.get(a[1][:8].lower(), "a service"))
    elif method == "DisplayPinCode":
        show("display-pin", a[0], a[1])
        inv.return_value(None)
    elif method == "DisplayPasskey":
        show("display-passkey", a[0], "%06d" % a[1], a[2])
        inv.return_value(None)
    elif method == "Cancel":
        if pending["inv"] is not None:
            finish("Canceled")
        else:
            settle(); tell({"id": serial[0], "kind": "none"})
        inv.return_value(None)
    elif method == "Release":
        inv.return_value(None)
    else:
        inv.return_dbus_error("org.bluez.Error.Rejected", "unknown")


def register(*_):
    try:
        for m in ("RegisterAgent", "RequestDefaultAgent"):
            args = GLib.Variant("(os)", (PATH, "KeyboardDisplay")) if m == "RegisterAgent" else GLib.Variant("(o)", (PATH,))
            bus.call_sync("org.bluez", "/org/bluez", "org.bluez.AgentManager1", m, args, None,
                          Gio.DBusCallFlags.NONE, 5000, None)
    except GLib.Error as e:
        if "AlreadyExists" not in e.message:
            print("tenka-bond-agent:", e.message, file=sys.stderr)


bus.register_object(PATH, Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0], on_call, None, None)
Gio.bus_watch_name_on_connection(bus, "org.bluez", Gio.BusNameWatcherFlags.NONE, register, None)
private_dir()
GLib.MainLoop().run()
