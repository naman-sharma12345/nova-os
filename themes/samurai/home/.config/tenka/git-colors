# Tenka colours for git (generated by scripts/gen-themes.py)
[color]
	ui = auto
[color "branch"]
	current = "#c9a35a" bold
	local = "#b8ab96"
	remote = "#7aa59b"
	upstream = "#7aa59b"
[color "diff"]
	meta = "#c9a35a"
	frag = "#6f86b8"
	func = "#b8ab96"
	commit = "#c9a35a"
	old = "#d8412f"
	new = "#7d8f5a"
	whitespace = "#d8412f" reverse
[color "status"]
	header = "#7d7466"
	branch = "#c9a35a" bold
	added = "#7d8f5a"
	updated = "#7d8f5a"
	changed = "#c9a35a"
	untracked = "#b8ab96"
	unmerged = "#d8412f" bold
[color "decorate"]
	HEAD = "#d8412f" bold
	branch = "#c9a35a"
	remoteBranch = "#7aa59b"
	tag = "#f2a7b5"
	stash = "#7d7466"
[color "grep"]
	match = "#d8412f" bold
	filename = "#c9a35a"
	linenumber = "#7d7466"
	separator = "#5b554f"
