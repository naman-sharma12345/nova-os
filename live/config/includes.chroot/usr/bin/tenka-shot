#!/bin/sh
d="$(xdg-user-dir PICTURES 2>/dev/null || echo $HOME/Pictures)/Screenshots"; mkdir -p "$d"
f="$d/$(date +%Y-%m-%d_%H-%M-%S).png"
if [ "$1" = area ]; then grim -g "$(slurp -d -b 00000066 -c ffffffaa)" "$f" || exit 1; else grim "$f"; fi
wl-copy < "$f"; notify-send -i "$f" "Captured" "$(basename "$f")"
