#!/bin/sh
# Picks the time zone for a machine still on UTC. Order: tenka.tz=<Area/City> on the kernel command
# line, then one quick look-up of the network's time zone (a few seconds at most, never blocks a boot
# without network). A zone someone chose (installer, timedatectl, a non-UTC /etc/timezone) is kept.
cur=$(cat /etc/timezone 2>/dev/null || readlink /etc/localtime | sed 's|.*/zoneinfo/||')
case "$cur" in ""|UTC|Etc/UTC|Etc/Universal|Universal|Zulu) ;; *) exit 0 ;; esac
tz=$(sed -n 's/.*tenka\.tz=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -z "$tz" ]; then
  for i in 1 2 3 4 5; do
    tz=$(curl -fsS -m 2 https://ipapi.co/timezone 2>/dev/null || curl -fsS -m 2 http://ip-api.com/line/?fields=timezone 2>/dev/null)
    [ -n "$tz" ] && break; sleep 1
  done
fi
tz=$(printf '%s' "$tz" | tr -d '[:space:]')
[ -n "$tz" ] && [ -e "/usr/share/zoneinfo/$tz" ] || exit 0
ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime
echo "$tz" > /etc/timezone
echo "tenka-timezone: $tz"
