#!/bin/sh
# Runs before SDDM. Picks Tenka (Hyprland) or Tenka Lite as the default/autologin session.
mode=$(/usr/libexec/tenka/tenka-hwdetect 2>/run/tenka-hwdetect.reason)
mkdir -p /run/tenka; echo "$mode" > /run/tenka/mode
# under pure CPU emulation, every software-rendered program (greeter, compositor, apps) gets 128-bit llvmpipe
# vectors: the emulated AVX2 path crashes them (see tenka-hwdetect); with KVM or real hardware nothing changes
if [ "$(systemd-detect-virt 2>/dev/null)" = qemu ]; then
  touch /run/tenka/emulated
  mkdir -p /etc/sddm.conf.d /etc/environment.d
  printf '[General]\nGreeterEnvironment=LP_NATIVE_VECTOR_WIDTH=128,GALLIUM_OVERRIDE_CPU_CAPS=sse4.1\n' > /etc/sddm.conf.d/30-tenka-emulated.conf
  printf 'LP_NATIVE_VECTOR_WIDTH=128\nGALLIUM_OVERRIDE_CPU_CAPS=sse4.1\n' > /etc/environment.d/95-tenka-emulated.conf
  # tumblerd makes thumbnails in-process: an AVIF decode (dav1d's SIMD code) segfaulted it under emulation and took
  # every thumbnail of that batch down with it (REAL-VM, a22ddfa nightly). Under emulation only, tumbler reads a loader
  # list without AVIF (tumblerd.service.d/tenka-emulated.conf), so .avif files get an icon and the rest get thumbnails.
  lc=$(ls /usr/lib/*/gdk-pixbuf-2.0/2.10.0/loaders.cache 2>/dev/null | head -1)
  if [ -n "$lc" ]; then
    awk 'BEGIN { RS = ""; ORS = "\n\n" } /libpixbufloader-avif\.so/ { next } { gsub(/ "image\/avif"/, ""); gsub(/ "avif"/, ""); print }' "$lc" > /run/tenka/loaders-noavif.cache
    printf 'GDK_PIXBUF_MODULE_FILE=/run/tenka/loaders-noavif.cache\n' > /run/tenka/tumbler.env
  fi
else
  rm -f /run/tenka/emulated /etc/sddm.conf.d/30-tenka-emulated.conf /etc/environment.d/95-tenka-emulated.conf /run/tenka/tumbler.env /run/tenka/loaders-noavif.cache
fi
if [ "$mode" = lite ]; then sess=tenka-lite.desktop; else sess=tenka.desktop; fi
# live session autologin (live-config writes /etc/sddm.conf)
if [ -f /etc/sddm.conf ] && grep -q '^\[Autologin\]' /etc/sddm.conf; then
  if grep -q '^Session=' /etc/sddm.conf; then sed -i "s/^Session=.*/Session=$sess/" /etc/sddm.conf
  else sed -i "/^\[Autologin\]/a Session=$sess" /etc/sddm.conf; fi
fi
# first boot of an installed system: preselect in the greeter
st=/var/lib/sddm/state.conf
if [ ! -s "$st" ] || ! grep -q '^Session=' "$st"; then
  mkdir -p /var/lib/sddm
  case "$mode" in lite) p=/usr/share/xsessions/tenka-lite.desktop ;; *) p=/usr/share/wayland-sessions/tenka.desktop ;; esac
  printf '[Last]\nSession=%s\n' "$p" > "$st"; chown sddm:sddm "$st" 2>/dev/null
fi
# live boot can pick the theme pack from the boot menu
case "$(cat /proc/cmdline)" in *tenka.theme=xianxia*) /usr/libexec/tenka/tenka-theme-system xianxia ;; esac
exit 0
