<?xml version="1.0" encoding="UTF-8"?>
<!-- Tenka: Thunar opens as a clean icon grid, no menubar (the menu lives behind the toolbar button) -->
<channel name="thunar" version="1.0">
  <property name="last-menubar-visible" type="bool" value="false"/>
  <property name="last-view" type="string" value="ThunarIconView"/>
  <!-- the path as breadcrumbs in the header band, not a typed line (Ctrl+L still opens the entry) -->
  <property name="last-location-bar" type="string" value="ThunarLocationButtons"/>
  <property name="last-icon-view-zoom-level" type="string" value="THUNAR_ZOOM_LEVEL_150_PERCENT"/>
  <property name="last-separator-position" type="int" value="230"/>
  <property name="last-show-hidden" type="bool" value="false"/>
  <property name="misc-single-click" type="bool" value="false"/>
  <!-- window titles read as the folder alone ("Documents"), never "tk - Thunar": the app is called Files everywhere else -->
  <!-- Thunar 4.20's file-highlight drawing fills a selected item with the full accent colour (a bright jade/red block)
       and ignores the theme; without it the selection is the theme's quiet tinted pill under the name -->
  <property name="misc-highlighting-enabled" type="bool" value="false"/>
  <property name="misc-window-title-style" type="string" value="THUNAR_WINDOW_TITLE_STYLE_FOLDER_NAME_WITHOUT_THUNAR_SUFFIX"/>
</channel>
