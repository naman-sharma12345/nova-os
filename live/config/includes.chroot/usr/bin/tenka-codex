#!/usr/bin/python3
"""tenka-codex: every key this desk answers to, read from the live config (not a stale cheat sheet).

Hyprland (the flagship): ~/.config/hypr/hyprland.lua and ~/.config/hypr/user.lua, every hl.bind() line.
Tenka Lite (XFCE): ~/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml.
Prints JSON for The Codex card (Super + /): {"session", "sources", "groups": [{"name", "keys": [{"keys": [...], "what"}]}]}.
  tenka-codex            the session it is running in (WAYLAND_DISPLAY + Hyprland -> hyprland, else lite)
  tenka-codex hyprland|lite
  tenka-codex text       the same, as plain text for a terminal
  tenka-codex open       show The Codex card (qs ipc on Hyprland; a small Qt window on Tenka Lite)
"""
import json, os, re, sys, html
import xml.etree.ElementTree as ET

HOME = os.path.expanduser("~")
ORDER = ["Open", "Windows", "Desks", "Tenka", "Session", "Media keys", "Yours"]

# what a bind does, in plain words: (group, words). Matched against the dispatcher text, first hit wins.
KNOWN = [
