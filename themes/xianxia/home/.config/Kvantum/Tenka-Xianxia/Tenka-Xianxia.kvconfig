[%General]
author=Tenka (generated by scripts/gen-themes.py)
comment=Tenka Xianxia: flat ink, one accent, no glow
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=4
composite=true
translucent_windows=false
blurring=false
popup_blurring=false
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=true
menu_separator_height=7
splitter_width=7
scroll_width=8
scroll_min_extent=40
scroll_arrows=false
transient_scrollbar=true
transient_groove=true
combo_as_lineedit=true
combo_menu=true
inline_spin_indicators=true
vertical_spin_indicators=false
slider_width=4
slider_handle_width=16
slider_handle_length=16
check_size=16
tooltip_delay=600
toolbar_icon_size=22
small_icon_size=16
large_icon_size=32
button_icon_size=16
layout_spacing=6
layout_margin=8
dark_titlebar=true
animate_states=true
no_inactiveness=true
reduce_window_opacity=0
reduce_menu_opacity=0
fill_rubberband=false
menubar_mouse_tracking=true
respect_DE=false
click_behavior=1
submenu_overlap=0
shadowless_popup=true

[GeneralColors]
window.color=#0b1513
base.color=#07100e
alt.base.color=#0c1816
button.color=#12211e
light.color=#364a45
mid.light.color=#1d332e
dark.color=#07100e
mid.color=#182a26
highlight.color=#428a6f
inactive.highlight.color=#316753
tooltip.base.color=#07100e
text.color=#eef3ec
window.text.color=#eef3ec
button.text.color=#eef3ec
disabled.text.color=#62716c
tooltip.text.color=#eef3ec
highlight.text.color=#eef3ec
link.color=#e2bd6b
link.visited.color=#f0a3b8
progress.indicator.text.color=#eef3ec

[Hacks]
transparent_dolphin_view=false
blur_konsole=false
transparent_ktitle_label=true
respect_darkness=true
force_size_grip=false
tint_on_mouseover=0
no_selection_tint=true
centered_forms=false
kcapacitybar_as_progressbar=true
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=60
lxqtmainmenu_iconsize=22
normal_default_pushbutton=true
transparent_menutitle=true
middle_click_scroll=false
scroll_jump_workaround=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
interior=true
interior.element=button
indicator.size=10
indicator.element=arrow
text.normal.color=#eef3ec
text.focus.color=#eef3ec
text.press.color=#eef3ec
text.toggle.color=#eef3ec
text.disabled.color=#62716c
text.shadow=0
text.margin=1
text.iconspacing=6
text.margin.left=10
text.margin.right=10
text.margin.top=4
text.margin.bottom=4
min_width=+0.3font
min_height=+0.3font
frame.expansion=0

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.margin.left=6
text.margin.right=6

[ToolbarButton]
inherits=PanelButtonTool

