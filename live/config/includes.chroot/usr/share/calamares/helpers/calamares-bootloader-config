#!/bin/bash
# Tenka: Debian's calamares-bootloader-config (calamares-settings-debian, diverted in 0100-base-setup), made to
# work without a package pool on the ISO. Only the grub install step differs.

CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")

# Install luks utilities if needed.
# Also, set secure permissions for the initramfs if we're configuring
# full-disk-encryption. The initramfs is re-generated later in the
# installation process so we only set the permissions snippet without
# regenerating the initramfs right now:
if [ "$(mount | grep $CHROOT" " | cut -c -16)" = "/dev/mapper/luks" ]; then
    echo "UMASK=0077" > $CHROOT/etc/initramfs-tools/conf.d/initramfs-permissions
    chroot $CHROOT apt-get -y install cryptsetup-initramfs cryptsetup keyutils
fi

echo "Running bootloader-config..."

if [ -d /sys/firmware/efi/efivars ]; then
    echo " * Installing grub-efi (uefi)..."
    pkg=grub-efi; bin=grub-efi-amd64-bin
else
    echo " * install grub... (bios)"
    pkg=grub-pc; bin=grub-pc-bin
fi
if ! DEBIAN_FRONTEND=noninteractive chroot $CHROOT apt-get -y install $pkg; then
    # Tenka: the ISO carries no package pool, so this apt-get had nothing to install from ("Package grub-pc has no
    # installation candidate"), /etc/default/grub never appeared, update-grub failed and the whole install stopped
    # (REAL-VM, d4bb378 nightly). The system already ships grub-pc-bin and grub-efi-amd64-bin; Calamares' grubcfg and
    # bootloader jobs (next in the sequence) run grub-install/grub-mkconfig with them. Only the defaults file is missing.
    echo " * $pkg not installable offline; using the $bin already in the system"
    chroot $CHROOT dpkg-query -W -f='${Status}' $bin 2>/dev/null | grep -q 'install ok installed' || exit 1
    [ -e $CHROOT/etc/default/grub ] || cp $CHROOT/usr/share/grub/default/grub $CHROOT/etc/default/grub
    mkdir -p $CHROOT/boot/grub   # grub-pc's postinst would have made it; update-grub below writes grub.cfg there
fi

# Re-enable os-prober:
sed -i "s/#GRUB_DISABLE_OS_PROBER=false/# OS_PROBER re-enabled by Debian Calamares installation:\nGRUB_DISABLE_OS_PROBER=false/g" $CHROOT/etc/default/grub
chroot $CHROOT /usr/sbin/update-grub
