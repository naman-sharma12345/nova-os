#!/bin/sh
# Started by Hyprland at login.
tenka-theme --init
rm -f "${XDG_RUNTIME_DIR:-/tmp}/tenka-seal"   # set again by the shell once it holds the polkit agent
# Lite's denser file-manager glass is for xfwm4 and for performance mode (no blur); with blur on,
# Hyprland's glass goes back to clear
if [ -e "$HOME/.config/tenka/perf" ]; then
  mkdir -p "$HOME/.cache/tenka"; cp -f "/usr/share/tenka/themes/$(tenka-theme --current)/lite-session.css" "$HOME/.cache/tenka/session.css" 2>/dev/null
else
  rm -f "$HOME/.cache/tenka/session.css"
fi
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE 2>/dev/null
if command -v qs >/dev/null 2>&1 && [ -d /etc/xdg/quickshell/tenka ]; then
  # the Tenka shell draws everything: wallpaper, desk, bar, dock, launcher, control center,
  # notifications, OSD, power menu. Performance mode makes glass frost itself instead of asking
  # the compositor to blur.
  [ -e "$HOME/.config/tenka/perf" ] && export TENKA_SELF_BLUR=1
  tenka-wallpaper restore >/dev/null 2>&1
  tenka-shell >/dev/null 2>&1 &   # keeps the shell up, and safe on software GL (see tenka-shell)
else
  tenka-wallpaper restore &
  waybar >/dev/null 2>&1 &
  mako >/dev/null 2>&1 &
  swayosd-server >/dev/null 2>&1 &
fi
hypridle >/dev/null 2>&1 &
nm-applet --indicator >/dev/null 2>&1 &
tenka-nightink run >/dev/null 2>&1 &   # night ink: the warm screen, with the sun when asked (tenka-nightink)
tenka-bond-agent >/dev/null 2>&1 &   # Bluetooth PIN / passkey questions, asked inside The Bond (Bond.qml)
# the shell is the polkit agent (The Seal, Seal.qml); hyprpolkitagent stands in when the shell has not registered
( sleep 15; [ -e "${XDG_RUNTIME_DIR:-/tmp}/tenka-seal" ] ||
  for a in /usr/libexec/hyprpolkitagent /usr/lib/hyprpolkitagent/hyprpolkitagent /usr/lib/x86_64-linux-gnu/libexec/hyprpolkitagent; do [ -x "$a" ] && { exec "$a" >/dev/null 2>&1; }; done ) &
wl-paste --type text --watch cliphist store >/dev/null 2>&1 &
wl-paste --type image --watch cliphist store >/dev/null 2>&1 &
sleep 1; tenka-sound login &
[ -e "$HOME/.config/tenka/welcomed" ] || tenka-welcome &
