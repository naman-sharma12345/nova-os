#!/bin/sh
# Tenka: per-file thumbnail helper (tenka-pixbuf.thumbnailer). tumblerd runs with a loader list that leaves out
# AVIF/HEIF/WebP/SVG (GDK_PIXBUF_MODULE_FILE from /run/tenka/tumbler.env); this process gets the full list, or the
# no-AVIF one under emulation. If it crashes, only this file loses its thumbnail. A hung decoder is killed after
# TENKA_THUMB_TIMEOUT seconds (default 30; SIGKILL 2 s after SIGTERM), so it can't stall tumbler's queue.
if [ -n "${TENKA_THUMB_LOADERS:-}" ]; then export GDK_PIXBUF_MODULE_FILE="$TENKA_THUMB_LOADERS"; else unset GDK_PIXBUF_MODULE_FILE; fi
exec timeout -k 2 "${TENKA_THUMB_TIMEOUT:-30}" /usr/bin/gdk-pixbuf-thumbnailer "$@"
